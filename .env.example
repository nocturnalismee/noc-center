APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated IPs/CIDRs of trusted reverse proxies (Nginx, load balancer,
# Cloudflare). Leave empty for a direct connection. Use `*` only when the
# origin accepts traffic exclusively from that proxy; otherwise clients can
# spoof X-Forwarded-For in audit rows and rate limits.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Alert email uses SMTP in production. Fill in the hosting/provider values, then
# use Settings -> Alerts -> Send test email. Shared hosting must allow outbound
# TCP to MAIL_HOST:MAIL_PORT; port 587 uses STARTTLS, 465 uses implicit TLS.
# Laravel 13 reads MAIL_SCHEME (leave null for automatic selection); the
# legacy MAIL_ENCRYPTION key is kept for older hosting guides.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noc@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Agent token rotation grace period in minutes (default 1440 = 24 hours).
# NOC_TOKEN_GRACE_MINUTES=1440

# Email and Telegram alerts are delivered by queued jobs. The queue worker must
# be running: shared hosting schedules `queue:work --stop-when-empty` every
# minute, a VPS runs the noc-queue systemd service. In-app alerts do not need
# either channel, but queued email/Telegram stay `pending` without a worker.
# VPS: set QUEUE_SCHEDULED_WORKER=false so the scheduler does not start a
# second worker alongside noc-queue.service.
QUEUE_SCHEDULED_WORKER=true
#
# Shared hosting recommended: CACHE_STORE=file, SESSION_DRIVER=file,
# QUEUE_CONNECTION=database. On a VPS with Redis, use redis for all three.
# The values above are development defaults; see README.md "Environment matrix".

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
